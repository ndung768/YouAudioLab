# Copy to .env and adjust as needed.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-in-development
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,youaudiolab.duthu.net
# Comma-separated origins (scheme + host, no path). Required for HTTPS login behind a proxy.
CSRF_TRUSTED_ORIGINS=http://localhost:8001,http://127.0.0.1:8001,https://youaudiolab.duthu.net
# Optional when serving only over HTTPS in production:
# SESSION_COOKIE_SECURE=true
# CSRF_COOKIE_SECURE=true

DATABASE_URL=postgresql://youaudiolab:youaudiolab@localhost:5433/youaudiolab_django
REDIS_URL=redis://localhost:6381/0
CELERY_BROKER_URL=redis://localhost:6381/0
CELERY_RESULT_BACKEND=redis://localhost:6381/0
STORAGE_ROOT=./storage
ENVIRONMENT=development
CELERY_WORKER_CONCURRENCY=2
CELERY_ENQUEUE_ENABLED=true
FFMPEG_BIN=ffmpeg
# Optional authenticated YouTube access (system-level only — not Project settings)
# YTDLP_COOKIES_FILE=/path/to/cookies.txt
FFMPEG_TIMEOUT_SECONDS=300
YTDLP_SOCKET_TIMEOUT=30

# ASR
ASR_ENGINE=fake
ASR_DEFAULT_PROVIDER=local
ASR_DEFAULT_MODEL_SIZE=base
ASR_MODEL_ALLOWLIST=tiny,base,small,medium,large-v3
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
ASR_OPENAI_ENABLED=false
ASR_OPENAI_DEFAULT_MODEL=gpt-4o-mini-transcribe
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# Required to store per-user/system OpenAI API keys (any passphrase). In development,
# falls back to DJANGO_SECRET_KEY if unset. Set explicitly before production.
ASR_SECRETS_KEY=dev-youaudiolab-asr-secrets-change-me
# Comma-separated AppUser UUIDs allowed to edit System ASR.
# Empty = every logged-in user is admin when ENVIRONMENT=development only.
# Prefer: python manage.py seed_admin --write-env
# ASR_ADMIN_USER_IDS=

AI_ENABLED=false
AI_DEFAULT_PROVIDER=ollama
AI_OLLAMA_BASE_URL=http://127.0.0.1:11434
AI_OLLAMA_DEFAULT_MODEL=llama3.2
# Comma-separated AppUser UUIDs allowed to edit System AI (same rules as ASR).
# AI_ADMIN_USER_IDS=

# Optional seed defaults for `python manage.py seed_admin`
# SEED_ADMIN_LOGIN=admin
# SEED_ADMIN_PASSWORD=ChangeMe-admin1
# SEED_ADMIN_DISPLAY_NAME=System Admin

# AUTH_ALLOW_X_USER_ID=  # empty = auto allow in development/test

# JWT + password
JWT_SECRET=dev-only-change-me-youaudiolab-jwt
JWT_EXPIRE_MINUTES=10080
